        case 'ru':
          return 'Внимание';
        case 'tr':
        default:
          return 'Dikkatli';
      }
    }

    if (score >= 40) {
      switch (code) {
        case 'en':
          return 'Risky';
        case 'ru':
          return 'Риск';
        case 'tr':
        default:
          return 'Riskli';
      }
    }

    switch (code) {
      case 'en':
        return 'Critical';
      case 'ru':
        return 'Критично';
      case 'tr':
      default:
        return 'Kritik';
    }
  }

